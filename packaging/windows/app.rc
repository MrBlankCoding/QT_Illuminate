#include <windows.h>

IDI_ICON1 ICON "illuminate.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "QT_Illuminate"
            VALUE "FileDescription", "Illuminate web browser"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "QT_Illuminate"
            VALUE "OriginalFilename", "QT_Illuminate.exe"
            VALUE "ProductName", "Illuminate"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END